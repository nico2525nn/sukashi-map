<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Camera preview + capture layers -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintTop_toBottomOf="@id/topAppBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/sideControlsLayout"
            app:layout_constraintBottom_toTopOf="@id/previewControls" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/cam_scrim_top"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:menu="@menu/main_top_menu"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/cam_icon"
            app:title="@string/app_short_name"
            app:titleTextColor="@color/cam_icon" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvRecTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@color/cam_icon_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/recording_time_format"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/cam_rec"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/previewView"
            app:layout_constraintStart_toStartOf="@id/previewView" />

        <ImageView
            android:id="@+id/photoPreview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/main_preview_photo_desc"
            android:scaleType="fitCenter"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/previewView"
            app:layout_constraintStart_toStartOf="@id/previewView"
            app:layout_constraintEnd_toEndOf="@id/previewView"
            app:layout_constraintBottom_toBottomOf="@id/previewView" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/videoPreview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/previewView"
            app:layout_constraintStart_toStartOf="@id/previewView"
            app:layout_constraintEnd_toEndOf="@id/previewView"
            app:layout_constraintBottom_toBottomOf="@id/previewView"
            app:use_controller="false" />

        <jp.nico2525.sukashimap.overlay.DraggableOverlayView
            android:id="@+id/overlayDragView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@id/previewView"
            app:layout_constraintStart_toStartOf="@id/previewView"
            app:layout_constraintEnd_toEndOf="@id/previewView"
            app:layout_constraintBottom_toBottomOf="@id/previewView" />

        <!-- M3 icon-button rail -->
        <LinearLayout
            android:id="@+id/sideControlsLayout"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:background="@color/cam_scrim_bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp"
            app:layout_constraintTop_toBottomOf="@id/topAppBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottomBar">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlash"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/flash_toggle"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_flash_off"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlipCamera"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/flip_camera"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_flip_camera"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLocation"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/main_refresh_location"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_location"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleLocationMode"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/main_toggle_location_mode"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_pin"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </LinearLayout>

        <!-- Capture-mode action row -->
        <LinearLayout
            android:id="@+id/previewControls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/cam_scrim_bottom"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottomBar">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTransportInfo"
                style="@style/Widget.SukashiMap.CamTonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_open_transport"
                app:icon="@drawable/ic_train" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptureMode"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/mode_switch_to_video"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_videocam"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCropFrame"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/main_crop_frame"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_crop"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="28dp" />
        </LinearLayout>

        <!-- Bottom bar: gallery / shutter FAB / settings -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/cam_scrim_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGallery"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/btn_gallery"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_gallery"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="28dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnCapture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/capture"
                android:src="@drawable/shutter_idle"
                app:backgroundTint="@color/cam_shutter_ring"
                app:fabSize="normal"
                app:maxImageSize="56dp"
                app:tint="@null"
                app:shapeAppearance="@style/ShapeAppearance.SukashiMap.Circle" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/settings"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="28dp" />
        </LinearLayout>

        <!-- Post-capture action row -->
        <LinearLayout
            android:id="@+id/postCaptureControls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/cam_scrim_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiscard"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/discard"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditTransport"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/main_open_transport"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_train"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/chooser_share_image"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareX"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/share_x"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_x"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareIG"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/share_instagram"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_instagram"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save"
                app:icon="@drawable/ic_check" />
        </LinearLayout>

        <!-- Video playback row (M3 slider) -->
        <LinearLayout
            android:id="@+id/videoControls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/cam_scrim_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/postCaptureControls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayPause"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/video_play_pause"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="1000"
                app:thumbColor="@color/md_primary"
                app:trackColorActive="@color/md_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMute"
                style="@style/Widget.SukashiMap.CamIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/video_mute_toggle"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_volume_on"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
